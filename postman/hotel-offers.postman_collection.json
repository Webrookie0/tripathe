        {
          "name": "Dependency health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('All dependencies up', () => {const body=pm.response.json(); pm.expect(body.status).to.eql('ok'); ['supplierA','supplierB','redis','temporal'].forEach(key=>pm.expect(body.dependencies[key].status).to.eql('up'));});"
                ]
              }
            }
          ],
          "response": []
