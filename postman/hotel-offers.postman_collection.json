          "name": "Supplier B raw hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/supplierB/hotels?city=delhi",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Four Delhi offers including cheaper Holtin', () => {const body=pm.response.json(); pm.expect(body).to.have.lengthOf(4); pm.expect(body.find(h=>h.name==='Holtin').price).to.eql(5340);});"
