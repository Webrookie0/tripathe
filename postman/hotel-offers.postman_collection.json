        {
          "name": "Supplier A raw hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/supplierA/hotels?city=delhi",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Four Delhi offers with supplier fields', () => { const body=pm.response.json(); pm.expect(body).to.have.lengthOf(4); body.forEach(h => {pm.expect(h).to.have.all.keys('hotelId','name','price','city','commissionPct'); pm.expect(h.city).to.eql('delhi');}); });"
                ]
              }
            }
          ],
          "response": []
