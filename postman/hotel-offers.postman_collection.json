      ]
    },
    {
      "name": "Supplier failure (optional)",
      "description": "Set MOCK_SUPPLIER_B_DOWN=true, recreate API, set runFailureChecks=true, and run only this folder. Restore flags afterward.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('runFailureChecks') !== 'true') pm.execution.skipRequest();"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Supplier B down \u2014 health degrades",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 503', () => pm.response.to.have.status(503));",
                  "pm.test('B down and A up', () => {const body=pm.response.json(); pm.expect(body.dependencies.supplierB.status).to.eql('down'); pm.expect(body.dependencies.supplierA.status).to.eql('up');});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier B down \u2014 comparison fails after retries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hotels?city=delhi",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 502', () => pm.response.to.have.status(502));",
                  "pm.test('No incomplete cheapest-offer response', () => pm.expect(pm.response.json().error.code).to.eql('SUPPLIER_UNAVAILABLE'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
