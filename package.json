{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel offer aggregation with Temporal orchestration and Redis price filtering",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "express": "5.3.0",
    "ioredis": "5.8.2"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
