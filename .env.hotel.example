# Copy to .env.hotel. Existing .env files from other projects are not used by Node.
HOTEL_PORT=3000
HOTEL_API_PORT=3000
HOTEL_API_BIND=127.0.0.1
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
REDIS_URL=redis://127.0.0.1:6379
SUPPLIER_BASE_URL=http://127.0.0.1:3000
SUPPLIER_TIMEOUT_MS=3000
SNAPSHOT_TTL_SECONDS=600
MOCK_SUPPLIER_A_DOWN=false
MOCK_SUPPLIER_B_DOWN=false
